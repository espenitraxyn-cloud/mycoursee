def display_courses(courses, title):

    for widget in course_list_frame.winfo_children():

        widget.destroy()

    result_title.config(
        text=title
    )

    for col in range(4):

        course_list_frame.grid_columnconfigure(
            col,
            weight=1,
            uniform="courses"
        )

    if not courses:

        welcome = tk.Frame(
            course_list_frame,
            bg=BG
        )

        welcome.grid(
            row=0,
            column=0,
            columnspan=4,
            sticky="nsew",
            padx=30,
            pady=80
        )

        tk.Label(
            welcome,
            text="NO MATCHING COURSE",
            font=("Segoe UI", 16, "bold"),
            bg=BG,
            fg=TEXT
        ).pack()

        tk.Label(
            welcome,
            text="Try adding more skills, characteristics, "
                 "or interests.",
            font=("Segoe UI", 10),
            bg=BG,
            fg=MUTED
        ).pack(
            pady=5
        )

        return

    for i, course in enumerate(courses):

        code, name, features = course

        row = i // 4
        col = i % 4

        card = create_course_card(
            course_list_frame,
            code,
            name,
            features
        )

        card.grid(
            row=row,
            column=col,
            padx=6,
            pady=6,
            sticky="nsew"
        )


