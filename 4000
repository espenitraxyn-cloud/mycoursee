# =========================================================

def suggest_course():

    characteristics = (
        characteristics_entry.get()
        .lower()
        .strip()
    )

    skills = (
        skills_entry.get()
        .lower()
        .strip()
    )

    interests = (
        interests_entry.get()
        .lower()
        .strip()
    )

    combined = (
        characteristics + " " +
        skills + " " +
        interests
    ).lower()

    if not combined.strip():

        messagebox.showwarning(
            "Missing Information",
            "Please enter your characteristics, skills, or interests."
        )

        return

    # =====================================================
    # BUILD SEARCH TERMS
    # =====================================================

    search_terms = []

    # First check complete phrases
    for phrase, related_words in ALIASES.items():

        if phrase in combined:

            search_terms.append(
                phrase
            )

            for related in related_words:

                search_terms.append(
                    related
                )

    # Also check individual words
    raw_words = (
        combined
        .replace(",", " ")
        .replace(".", " ")
        .replace("/", " ")
        .replace("-", " ")
        .split()
    )

    for word in raw_words:

        if len(word) < 3:
            continue

        search_terms.append(
            word
        )

        if word in ALIASES:

            for related in ALIASES[word]:

                search_terms.append(
                    related
                )

    # Remove duplicates
    search_terms = list(
        dict.fromkeys(search_terms)
    )

    # =====================================================
    # DATABASE
    # =====================================================

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, skills, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    results = []

    # =====================================================
    # SMART MATCHING
    # =====================================================

    for code, name, course_skills, features in courses:

        code_text = code.lower()
        name_text = name.lower()
        skill_text = course_skills.lower()
        feature_text = features.lower()

        searchable = (
            code_text + " " +
            name_text + " " +
            skill_text + " " +
            feature_text
        )

        score = 0

        # =================================================
        # MATCH USER TERMS
        # =================================================

        for term in search_terms:

            term = term.strip().lower()

            if len(term) < 3:
                continue

            if term in skill_text:

                score += 8

            elif term in name_text:

                score += 7

            elif term in feature_text:

                score += 4

            elif term in searchable:

                score += 2

        # =================================================
        # STRONG COURSE CONNECTIONS
        # =================================================

        # COMPUTER
        if any(x in combined for x in [
            "coding",
            "programming",
            "computer",
            "technology",
            "software",
            "programmer",
            "coder"
        ]):

            if code == "BSIT":
                score += 8

            elif code == "BSCS":
                score += 8

            elif code == "BSCpE":
                score += 6

        # MATHEMATICS
        if any(x in combined for x in [
