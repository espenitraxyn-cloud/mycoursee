        text=info["tuition"],
        font=("Segoe UI", 8),
        bg=WHITE,
        fg=MUTED,
        wraplength=220,
        justify="left",
        anchor="w"
    ).pack(
        fill="x"
    )

    tk.Label(
        body,
        text="VIEW PROGRAM  →",
        font=("Segoe UI", 8, "bold"),
        bg=WHITE,
        fg=PHINMA_GREEN,
        anchor="w"
    ).pack(
        fill="x",
        pady=(5, 0)
    )

    def open_course(event=None):

        show_course_details(
            code,
            name,
            features
        )

    def hover_on(event=None):

        card.config(
            bg=PHINMA_LIGHT,
            highlightbackground=PHINMA_GREEN
        )

        body.config(
            bg=PHINMA_LIGHT
        )

        for child in body.winfo_children():

            child.config(
                bg=PHINMA_LIGHT
            )

    def hover_off(event=None):

        card.config(
            bg=WHITE,
            highlightbackground=BORDER
        )

        body.config(
            bg=WHITE
        )

        for child in body.winfo_children():

            child.config(
                bg=WHITE
            )

    card.bind(
        "<Button-1>",
        open_course
    )

    card.bind(
        "<Enter>",
        hover_on
    )

    card.bind(
        "<Leave>",
        hover_off
    )

    for child in body.winfo_children():

        child.bind(
            "<Button-1>",
            open_course
        )

        child.bind(
            "<Enter>",
            hover_on
        )

        child.bind(
            "<Leave>",
            hover_off
        )

    return card


