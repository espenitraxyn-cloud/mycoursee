# SEARCH / RECOMMEND
# =========================================================

def suggest_course():

    characteristics = characteristics_entry.get().lower().strip()
    skills = skills_entry.get().lower().strip()
    interests = interests_entry.get().lower().strip()

    combined = (
        characteristics + " " +
        skills + " " +
        interests
    )

    if not combined.strip():

        messagebox.showwarning(
            "Missing Information",
            "Please enter your characteristics, skills, or interests."
        )

        return

    keywords = combined.replace(",", " ").split()

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, skills, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    results = []

    for code, name, course_skills, features in courses:

        searchable = (
            code + " " +
            name + " " +
            course_skills + " " +
            features
        ).lower()

        score = 0

        for keyword in keywords:

            if keyword in searchable:
                score += 1

        if score > 0:

            results.append(
                (
                    score,
                    code,
                    name,
                    features
                )
            )

    results.sort(
        reverse=True,
        key=lambda x: x[0]
    )

    for widget in course_list_frame.winfo_children():
        widget.destroy()

    if not results:

        result_title.config(
            text="No Matching Course"
        )

        tk.Label(
            course_list_frame,
            text=(
                "No matching course found.\n\n"
                "Try adding more skills or interests."
            ),
            font=("Segoe UI", 11),
            bg="#F8FAFC",
            fg="#64748B",
            pady=60
        ).grid(
            row=0,
            column=0,
            columnspan=4,
            sticky="nsew"
        )

        return

    result_title.config(
        text=f"Recommended Courses ({len(results)})"
    )

    for col in range(4):

        course_list_frame.grid_columnconfigure(
            col,
            weight=1,
            uniform="courses"
        )

    for i, result in enumerate(results):

        score, code, name, features = result

        row = i // 4
        col = i % 4

        card = create_course_card(
            course_list_frame,
            code,
            name,
            features
        )

        card.grid(
            row=row,
            column=col,
            padx=6,
            pady=6,
            sticky="nsew"
        )


