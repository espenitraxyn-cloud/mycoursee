def create_course_card(parent, code, name, features):

    info = get_course_info(code)

    card = tk.Frame(
        parent,
        bg="white",
        bd=1,
        relief="solid",
        height=115,
        padx=10,
        pady=8,
        cursor="hand2"
    )

    card.grid_propagate(False)

    tk.Label(
        card,
        text=code,
        font=("Segoe UI", 11, "bold"),
        bg="white",
        fg="#059669",
        cursor="hand2"
    ).pack(
        anchor="w"
    )

    tk.Label(
        card,
        text=name,
        font=("Segoe UI", 9, "bold"),
        bg="white",
        fg="#0F172A",
        wraplength=220,
        justify="left",
        cursor="hand2"
    ).pack(
        anchor="w",
        pady=(4, 3)
    )

    tk.Label(
        card,
        text=info["tuition"],
        font=("Segoe UI", 8),
        bg="white",
        fg="#64748B",
        wraplength=220,
        justify="left",
        cursor="hand2"
    ).pack(
        anchor="w"
    )

    def open_course(event=None):

        show_course_details(
            code,
            name,
            features
        )

    def hover_on(event=None):

        card.config(
            bg="#ECFDF5"
        )

        for child in card.winfo_children():
            child.config(
                bg="#ECFDF5"
            )

    def hover_off(event=None):

        card.config(
            bg="white"
        )

        for child in card.winfo_children():
            child.config(
                bg="white"
            )

    card.bind(
        "<Button-1>",
        open_course
    )

    card.bind(
        "<Enter>",
        hover_on
    )

    card.bind(
        "<Leave>",
        hover_off
    )

    for child in card.winfo_children():

        child.bind(
            "<Button-1>",
            open_course
        )

        child.bind(
            "<Enter>",
            hover_on
        )

        child.bind(
            "<Leave>",
            hover_off
        )

    return card


