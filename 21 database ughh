def show_all_courses():

    for widget in course_list_frame.winfo_children():
        widget.destroy()

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    result_title.config(
        text=f"Available Courses ({len(courses)})"
    )

    for col in range(4):

        course_list_frame.grid_columnconfigure(
            col,
            weight=1,
            uniform="courses"
        )

    for i, course in enumerate(courses):

        code, name, features = course

        row = i // 4
        col = i % 4

        card = create_course_card(
            course_list_frame,
            code,
            name,
            features
        )

        card.grid(
            row=row,
            column=col,
            padx=6,
            pady=6,
            sticky="nsew"
        )


