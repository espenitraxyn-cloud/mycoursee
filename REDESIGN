        interests_entry.get()
        .lower()
        .strip()
    )

    combined = (
        characteristics + " " +
        skills + " " +
        interests
    )

    if not combined.strip():

        messagebox.showwarning(
            "Missing Information",
            "Please enter your characteristics, skills, or interests."
        )

        return

