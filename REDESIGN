        word
        for word in combined.replace(",", " ").split()
        if len(word) >= 2
    ]

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, skills, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

