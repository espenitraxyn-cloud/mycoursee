def create_course_card(parent, code, name, features):

    info = get_course_info(code)

    card = tk.Frame(
        parent,
        bg=WHITE,
        highlightbackground=BORDER,
        highlightthickness=1,
        cursor="hand2"
    )

    card.grid_propagate(False)

    tk.Frame(
        card,
        bg=PHINMA_GREEN,
        height=5
    ).pack(
        fill="x"
    )

    body = tk.Frame(
        card,
        bg=WHITE,
        padx=12,
        pady=8
    )

    body.pack(
        fill="both",
        expand=True
    )

    tk.Label(
        body,
        text=code,
        font=("Segoe UI", 11, "bold"),
        bg=WHITE,
        fg=PHINMA_GREEN,
        anchor="w"
    ).pack(
        fill="x"
    )

    tk.Label(
        body,
        text=name,
        font=("Segoe UI", 9, "bold"),
        bg=WHITE,
        fg=TEXT,
        wraplength=220,
        justify="left",
        anchor="w"
    ).pack(
        fill="x",
        pady=(3, 3)
    )

    tk.Label(
        body,
        text=info["tuition"],
        font=("Segoe UI", 8),
        bg=WHITE,
        fg=MUTED,
        wraplength=220,
        justify="left",
        anchor="w"
    ).pack(
        fill="x"
    )

    tk.Label(
        body,
        text="VIEW PROGRAM  →",
        font=("Segoe UI", 8, "bold"),
        bg=WHITE,
        fg=PHINMA_GREEN,
        anchor="w"
    ).pack(
        fill="x",
        pady=(5, 0)
    )

    def open_course(event=None):

        show_course_details(
            code,
            name,
            features
        )

    def hover_on(event=None):

        card.config(
            bg=PHINMA_LIGHT,
            highlightbackground=PHINMA_GREEN
        )

        body.config(
            bg=PHINMA_LIGHT
        )

        for child in body.winfo_children():
            child.config(
                bg=PHINMA_LIGHT
            )

    def hover_off(event=None):

        card.config(
            bg=WHITE,
            highlightbackground=BORDER
        )

        body.config(
            bg=WHITE
        )

        for child in body.winfo_children():
            child.config(
                bg=WHITE
            )

    card.bind(
        "<Button-1>",
        open_course
    )

    card.bind(
        "<Enter>",
        hover_on
    )

    card.bind(
        "<Leave>",
        hover_off
    )

    for child in body.winfo_children():

        child.bind(
            "<Button-1>",
            open_course
        )

        child.bind(
            "<Enter>",
            hover_on
        )

        child.bind(
            "<Leave>",
            hover_off
        )

    return card


# =========================================================
# DISPLAY COURSES
# =========================================================

def display_courses(courses, title):

    for widget in course_list_frame.winfo_children():
        widget.destroy()

    result_title.config(
        text=title
    )

    for col in range(4):

        course_list_frame.grid_columnconfigure(
            col,
            weight=1,
            uniform="courses"
        )

    if not courses:

        welcome = tk.Frame(
            course_list_frame,
            bg=BG
        )

        welcome.grid(
            row=0,
            column=0,
            columnspan=4,
            sticky="nsew",
            padx=30,
            pady=80
        )

        tk.Label(
            welcome,
            text="NO MATCHING COURSE",
            font=("Segoe UI", 16, "bold"),
            bg=BG,
            fg=TEXT
        ).pack()

        tk.Label(
            welcome,
            text="Try adding more skills, characteristics, "
                 "or interests.",
            font=("Segoe UI", 10),
            bg=BG,
            fg=MUTED
        ).pack(
            pady=5
        )

        return

    for i, course in enumerate(courses):

        code, name, features = course

        row = i // 4
        col = i % 4

        card = create_course_card(
            course_list_frame,
            code,
            name,
            features
        )

        card.grid(
            row=row,
            column=col,
            padx=6,
            pady=6,
            sticky="nsew"
        )


