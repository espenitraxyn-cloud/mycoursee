def show_all_courses():

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    display_courses(
        courses,
        f"ALL PROGRAMS  •  {len(courses)} COURSES"
    )


