    for code, name, course_skills, features in courses:

        searchable = (
            code + " " +
            name + " " +
            course_skills + " " +
            features
        ).lower()

        score = 0

        for keyword in keywords:

            if keyword in searchable:
                score += 1

        if score > 0:

            results.append(
                (
                    score,
                    code,
                    name,
                    features
                )
            )

    results.sort(
        reverse=True,
        key=lambda x: x[0]
    )

    result_courses = []

    for score, code, name, features in results:

        result_courses.append(
            (
                code,
                name,
                features
            )
        )

    display_courses(
        result_courses,
        f"RECOMMENDED PROGRAMS  •  {len(result_courses)} MATCHES"
    )


