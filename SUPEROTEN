# =========================================================
# DATABASE
# =========================================================

BASE_DIR = __import__("os").path.dirname(
    __import__("os").path.abspath(__file__)
)

DB_PATH = __import__("os").path.join(
    BASE_DIR,
    "mycourse.db"
)


def get_connection():
    return sqlite3.connect(DB_PATH)


def create_table():

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS courses (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            course_code TEXT NOT NULL UNIQUE,
            course_name TEXT NOT NULL,
            skills TEXT NOT NULL,
            features TEXT NOT NULL
        )
    """)

    # IMPORTANT:
    # Hindi nito dini-delete ang existing database.
    # Nagdadagdag lang ito ng courses na wala pa.

    additional_courses = [

        (
            "BSPsych",
            "BS Psychology",
            "Human Behavior, Communication, Research, Psychology",
            "Studies human behavior, mental processes, psychological assessment, research, and applications of psychology."
        ),

        (
            "BACOM",
            "BA Communication",
            "Communication, Writing, Media, Public Speaking",
            "Develops communication skills for media, broadcasting, digital content, public relations, journalism, and communication-related fields."
        )
    ]

    cur.executemany("""
        INSERT OR IGNORE INTO courses
        (course_code, course_name, skills, features)
        VALUES (?, ?, ?, ?)
    """, additional_courses)

    conn.commit()
    conn.close()


