    )

    for widget in card.winfo_children():

        widget.bind(
            "<Button-1>",
            open_details
        )

    # Hover effect
    def enter(event=None):

        card.config(
            bg="#ECFDF5"
        )

        for widget in card.winfo_children():

            widget.config(
                bg="#ECFDF5"
            )

    def leave(event=None):

        card.config(
            bg="white"
        )

        for widget in card.winfo_children():

            widget.config(
                bg="white"
            )

    card.bind(
        "<Enter>",
        enter
    )

    card.bind(
        "<Leave>",
        leave
    )

    for widget in card.winfo_children():

        widget.bind(
            "<Enter>",
            enter
        )

        widget.bind(
            "<Leave>",
            leave
        )

    return card


