            "careers":
                "• Career opportunities depend on the student's specialization."
        }
    )


# =========================================================
# COURSE DETAILS WINDOW
# =========================================================

def show_course_details(code, name, features):

    detail_win = tk.Toplevel(root)

    detail_win.title(
        f"{code} - Course Information"
    )

    detail_win.geometry(
        "760x680"
    )

    detail_win.minsize(
        650,
        580
    )

    detail_win.config(
        bg="#F8FAFC"
    )

    detail_win.grab_set()

    info = get_course_info(code)

    # -----------------------------------------------------
    # HEADER
    # -----------------------------------------------------

    header = tk.Frame(
        detail_win,
        bg="#0F172A",
        height=95
    )

    header.pack(
        fill="x"
    )

    header.pack_propagate(False)

    tk.Label(
        header,
        text=code,
        font=("Segoe UI", 22, "bold"),
        bg="#0F172A",
        fg="#34D399"
    ).pack(
        pady=(15, 0)
    )

    tk.Label(
        header,
        text=info["official_name"] if info["official_name"] else name,
        font=("Segoe UI", 12),
        bg="#0F172A",
        fg="#E2E8F0"
    ).pack(
        pady=(2, 0)
    )

    # -----------------------------------------------------
    # SCROLL AREA
    # -----------------------------------------------------

    outer = tk.Frame(
        detail_win,
        bg="#F8FAFC"
    )

    outer.pack(
        fill="both",
        expand=True,
        padx=15,
        pady=15
    )

    canvas = tk.Canvas(
        outer,
        bg="#F8FAFC",
        highlightthickness=0
    )

    scrollbar = tk.Scrollbar(
        outer,
        orient="vertical",
        command=canvas.yview
    )

    content = tk.Frame(
        canvas,
        bg="#F8FAFC"
    )

    window_id = canvas.create_window(
        (0, 0),
        window=content,
        anchor="nw"
    )

    def update_scroll(event=None):

        canvas.configure(
            scrollregion=canvas.bbox("all")
        )

    def update_width(event):

        canvas.itemconfigure(
            window_id,
            width=event.width
        )

    content.bind(
        "<Configure>",
        update_scroll
    )

    canvas.bind(
        "<Configure>",
        update_width
    )

    canvas.configure(
        yscrollcommand=scrollbar.set
    )

    canvas.pack(
        side="left",
        fill="both",
        expand=True
    )

    scrollbar.pack(
        side="right",
        fill="y"
    )

    # -----------------------------------------------------
    # INFORMATION CARD
    # -----------------------------------------------------

    card = tk.Frame(
        content,
        bg="white",
        padx=25,
        pady=25
    )

    card.pack(
        fill="both",
        expand=True
    )

    def add_section(title, text):

        tk.Label(
            card,
            text=title,
            font=("Segoe UI", 12, "bold"),
            bg="white",
            fg="#0F172A",
            anchor="w"
        ).pack(
            fill="x",
            pady=(10, 4)
        )

        tk.Label(
            card,
            text=text,
            font=("Segoe UI", 10),
            bg="white",
            fg="#334155",
            justify="left",
            anchor="w",
            wraplength=650
        ).pack(
            fill="x",
            anchor="w",
            pady=(0, 8)
        )

    add_section(
        "LOCATION",
        "Arellano Street, Downtown District, "
        "Dagupan City, Pangasinan"
    )

    add_section(
        "PROGRAM FOCUS",
        info["focus"]
    )

    add_section(
        "ADMISSION REQUIREMENTS",
        info["admission"]
    )

    add_section(
        "TUITION AND FEES",
        info["tuition"]
    )

    add_section(
        "SCHOLARSHIPS",
        info["scholarship"]
    )

    add_section(
        "CAREER OPPORTUNITIES",
        info["careers"]
    )

    add_section(
        "COURSE DETAILS",
        features
    )

    # -----------------------------------------------------
    # MOUSE WHEEL
    # -----------------------------------------------------

    def mouse_wheel(event):

        canvas.yview_scroll(
            int(-1 * (event.delta / 120)),
            "units"
        )

    canvas.bind_all(
        "<MouseWheel>",
        mouse_wheel
    )

    def close_details():

        canvas.unbind_all(
            "<MouseWheel>"
        )

        detail_win.destroy()

    detail_win.protocol(
        "WM_DELETE_WINDOW",
        close_details
    )


