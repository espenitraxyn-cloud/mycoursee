def show_all_courses():

    for widget in course_list_frame.winfo_children():

        widget.destroy()

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    total = len(courses)

    result_title.config(
