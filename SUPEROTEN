    )

    for column in range(4):

        course_list_frame.grid_columnconfigure(
            column,
            weight=1,
            uniform="course_columns"
        )

    for i, (code, name, features) in enumerate(courses):

        row = i // 4
        column = i % 4

        card = create_course_card(
            course_list_frame,
            code,
            name,
            features
        )

        card.grid(
            row=row,
            column=column,
            padx=6,
            pady=6,
            sticky="nsew"
        )


# =========================================================
# SUGGEST COURSE
# =========================================================

def suggest_course():

    name = name_entry.get().strip()
    characteristics = characteristics_entry.get().strip().lower()
    skills = skills_entry.get().strip().lower()
    interests = interests_entry.get().strip().lower()

    if not name:
        messagebox.showwarning(
            "Missing Name",
            "Please enter your name first."
        )
        return

    combined = (
        characteristics + " " +
        skills + " " +
        interests
    )

    keywords = [
        word.strip()
        for word in combined.replace(",", " ").split()
        if word.strip()
    ]

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT course_code, course_name, skills, features
        FROM courses
        ORDER BY id
    """)

    courses = cur.fetchall()

    conn.close()

    results = []

    for course in courses:

        code, course_name, course_skills, features = course

        search_text = (
            code + " " +
            course_name + " " +
            course_skills + " " +
            features
        ).lower()

        score = 0

        for keyword in keywords:

            if keyword in search_text:
                score += 1

        if score > 0:

            results.append(
                (
                    score,
                    code,
                    course_name,
                    features
                )
            )

    results.sort(
        reverse=True,
        key=lambda x: x[0]
    )

    # Clear previous cards
    for widget in course_list_frame.winfo_children():

        widget.destroy()

    if not results:

        result_title.config(
            text="No Matching Course"
        )

        no_result = tk.Label(
            course_list_frame,
            text=(
                "No matching course found.\n\n"
                "Try entering more skills, interests, "
                "or characteristics."
            ),
            font=("Segoe UI", 11),
            bg="white",
            fg="#64748B",
            justify="center",
            pady=50
        )

        no_result.grid(
            row=0,
            column=0,
            columnspan=4,
            sticky="nsew"
        )

        return

    result_title.config(
        text=f"Recommended Courses ({len(results)})"
    )

    for column in range(4):

        course_list_frame.grid_columnconfigure(
            column,
            weight=1,
            uniform="course_columns"
        )

    for i, result in enumerate(results):

        score, code, course_name, features = result

        row = i // 4
        column = i % 4

        card = create_course_card(
            course_list_frame,
            code,
            course_name,
            features
        )

        card.grid(
            row=row,
            column=column,
            padx=6,
            pady=6,
            sticky="nsew"
        )


